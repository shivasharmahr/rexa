{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "api/server.js"
    },
    {
      "src": "/app\\.js$",
      "dest": "app.js"
    },
    {
      "src": "/(static|assets|logos)/(.*)$",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*\\.(html|css|png|jpg|jpeg|gif|svg|webp|ico|json|xml|txt|woff|woff2|ttf|eot))$",
      "dest": "$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/server.js"
    }
  ]
}
