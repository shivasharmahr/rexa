{
  "version": 2,
  "buildCommand": "npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*\\.html)$",
      "dest": "$1"
    },
    {
      "src": "/(.*\\.css)$",
      "dest": "$1"
    },
    {
      "src": "/(.*\\.js)$",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      },
      "dest": "$1"
    },
    {
      "src": "/(.*\\.(jpg|jpeg|png|gif|svg|webp|ico|json|xml|txt))$",
      "dest": "$1"
    },
    {
      "src": "^/api/(.*)",
      "dest": "api/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/server.js"
    }
  ]
}
