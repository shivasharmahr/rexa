{
  "name": "rexa-contact-api",
  "version": 2,
  "functions": {
    "api/server.js": {
      "includeFiles": "{*.html,*.css,*.js,assets/**,logos/**,robots.txt,llms.txt,sitemap.xml}"
    }
  },
  "routes": [
    {
      "src": "/general(\\.html)?/?",
      "status": 301,
      "headers": {
        "Location": "/corporate-risk"
      }
    },
    {
      "src": "/life(\\.html)?/?",
      "status": 301,
      "headers": {
        "Location": "/employee-benefits"
      }
    },
    {
      "src": "/(assets/.*|logos/.*|styles\\.css|app\\.js|lead-form\\.js|offers\\.json|robots\\.txt|sitemap\\.xml|llms\\.txt)$",
      "dest": "/$1"
    },
    {
      "src": "^/api/(.*)",
      "dest": "api/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/server.js"
    }
  ]
}
